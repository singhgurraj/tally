# Copy this file to .env and fill in your values.
# Load it with: node -r dotenv/config server.js  (or use a process manager)

# Express session secret — change this to a long random string in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe test-mode keys (get them from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...   # the monthly subscription price ID you create in Stripe

# Stripe webhook secret — from "stripe listen --forward-to localhost:3000/api/stripe/webhook"
# or from the Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# Public URL of this app (used for Stripe success/cancel redirects).
# Leave blank for local development (defaults to http://localhost:3000).
APP_URL=

# Server port (default: 3000)
PORT=3000
